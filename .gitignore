# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...ama şablon commit'lenir: create-next-app'in `.env*` glob'u onu da yutuyordu.
!.env.example

# vercel
.vercel

# Claude Code — onaylanan komutlar burada DÜZ METİN saklanır (anahtar sızma
# riski). Proje hafızası (`CLAUDE.md`, `.claude/LEARNINGS*.md`) commit'lenir,
# yerel ayar dosyası girmez.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# veri hattı önbelleği (yerel hızlandırma — repoya girmez)
.cache/

# kapıdan geçemeyen model taslakları (insan incelemesi için, yayın değil)
.needs-review/

# `prebuild` her derlemede yeniden üretir; commit'lenirse bayatlar
/public/veri/
/public/llms.txt
