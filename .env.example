# ─────────────────────────────────────────────────────────────────────────
# miamiendeksi.com — ortam değişkenleri
#
# Bu dosya ŞABLONDUR ve repoya girer. Gerçek değerler `.env.local`'e yazılır
# ve `.gitignore` onu tutar. Hiçbir gerçek anahtarı bu dosyaya yazma.
#
# ÖNEMLİ: Anahtarları kabuk komutunun İÇİNE yazma (`FOO=sk-... npm run ...`).
# Claude Code onaylanan komutları `.claude/settings.local.json`'a düz metin
# olarak kaydeder ve orada kalıcı olur. Değerleri bu dosyalara yaz.
# ─────────────────────────────────────────────────────────────────────────

# ── Site (isteğe bağlı) ──────────────────────────────────────────────────
# Kanonik URL'ler, sitemap ve JSON-LD bunu kullanır. Boşsa üretim alan adı
# varsayılır; Vercel önizlemelerinde ayarlamak gerekmez.
NEXT_PUBLIC_SITE_URL=https://miamiendeksi.com

# ── Ölçümleme (isteğe bağlı) ─────────────────────────────────────────────
# BOŞ BIRAKILABİLİR. Boşken hiçbir GA betiği sayfaya girmez ve çerez onay
# bandı da HİÇ gösterilmez — izlemediğimiz bir ziyaretçiden onay istemek
# hem gereksiz hem yanıltıcıdır.
#
# Doluyken bile gtag yalnızca ziyaretçi "Kabul et" dedikten SONRA DOM'a
# basılır. Onay gizlemeyi değil, RENDER'ı kontrol eder.
#
# NEXT_PUBLIC_* değerleri derleme anında gömülür: Vercel'e ekledikten sonra
# yeniden deploy edilmeden mevcut önizlemelerde etkin olmaz.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ── Aylık yorum üretimi (yalnız sunucu / CI) ─────────────────────────────
# `npm run index:generate` için gerekir. Sitenin RENDER'ı buna bağlı
# değildir; anahtar yoksa yalnızca aylık yorum yazısı üretilemez, sayfalar
# ve sayılar etkilenmez.
#
# Ağsız hat testi anahtarsız çalışır: npm run index:dry
OPENROUTER_API_KEY=

# ── Veri hattı ───────────────────────────────────────────────────────────
# Zillow ve Redfin herkese açık CSV yayınlar, anahtar İSTEMEZ.
# FRED anahtarsız da çalışır (fredgraph.csv genel uçtur) — bu yüzden burada
# FRED anahtarı yok. Bir gün API uçlarına geçilirse buraya eklenir.
